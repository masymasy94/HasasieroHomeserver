# ========================================
# Root .gitignore — whitelist approach
# ========================================

# Ignore everything by default
*

# Allow subdirectories
!homeserver/
!apps/

# ========================================
# homeserver/ — self-hosted services stack
# ========================================
!homeserver/.gitignore
!homeserver/docker-compose.yml
!homeserver/.env.example

# Sentinella (controlli + push)
!homeserver/sentinella/
!homeserver/sentinella/*.py

# Backup restic (non attivo)
!homeserver/backup/
!homeserver/backup/backup.sh
!homeserver/backup/homeserver-backup.*

!homeserver/homepage/
!homeserver/homepage/config/
!homeserver/homepage/config/*.yaml

!homeserver/prowlarr-search/
!homeserver/prowlarr-search/index.html
!homeserver/prowlarr-search/nginx.conf
!homeserver/prowlarr-search/config.js.example

!homeserver/nut/
!homeserver/nut/conf/
!homeserver/nut/conf/*.conf

!homeserver/jackett/
!homeserver/jackett/config/
!homeserver/jackett/config/cardigann/
!homeserver/jackett/config/cardigann/definitions/
!homeserver/jackett/config/cardigann/definitions/*.yml


!homeserver/github-runner/
!homeserver/github-runner/Dockerfile
!homeserver/github-runner/multi-runner-entrypoint.sh

!homeserver/qbittorrent/
!homeserver/qbittorrent/config/
!homeserver/qbittorrent/config/custom-cont-init.d/
!homeserver/qbittorrent/config/custom-cont-init.d/*.sh

# ========================================
# apps/ — multi-app deployment platform
# ========================================

# Scripts
!apps/scripts/
!apps/scripts/*.sh
!apps/scripts/lib/
!apps/scripts/lib/*.sh

# Templates
!apps/templates/
!apps/templates/*

# Infrastructure (network setup; .env con ACCESS_TOKEN resta fuori da git)
!apps/infrastructure/
!apps/infrastructure/setup-network.sh

# Config (no secrets)
!apps/config/
!apps/config/apps.conf
!apps/config/settings.conf.example

# Jackett definitions
!apps/jackett/
!apps/jackett/cardigann-definitions/
!apps/jackett/cardigann-definitions/*.yml

# Services gitignore template
!apps/services.gitignore

# Root files
!.gitignore
!README.md

# Istruzioni per Claude (una per stack)
!CLAUDE.md
!apps/CLAUDE.md

# Deployments: cloni di altri repo (hanno il loro .git), qui non si tracciano
apps/deployments/

# ========================================
# Explicitly exclude secrets & heavy data
# ========================================
.env
*.env
config.env
settings.conf
**/secrets/
*.json
*.json.gz
*.log
*.db
*.db-wal
*.db-shm
*.sqlite
*.pem
*.key
*.cert
**/__pycache__/
**/node_modules/
**/cache/
**/data/
**/DataProtection/

# Segreti: config SOPS (solo chiave pubblica) e falsi positivi gitleaks
!.sops.yaml
!.gitleaksignore

# Istruzioni per Claude: restano LOCALI, questo repo e pubblico. Senza slash iniziale
# vale a ogni livello (radice, apps/, homeserver/). I repo annidati hanno il loro .git,
# quindi il CLAUDE.md di dmforge & co. non e toccato da questa regola.
CLAUDE.md
