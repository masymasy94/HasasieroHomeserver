# ========================================
# Ignore ALL runtime data and volumes
# ========================================

# Ignore everything by default
*

# ========================================
# Whitelist only config files we want to track
# ========================================

# Git and Docker Compose
!.gitignore
!docker-compose.yml
!.env.example
!README.md
!CLAUDE.md

# Homepage dashboard config
!homepage/
!homepage/config/
!homepage/config/*.yaml

# Prowlarr Search (custom search UI)
!prowlarr-search/
!prowlarr-search/index.html
!prowlarr-search/nginx.conf
!prowlarr-search/config.js.example

# NUT config
!nut/
!nut/conf/
!nut/conf/*.conf

# Jackett custom Cardigann definitions (no credentials)
!jackett/
!jackett/config/
!jackett/config/cardigann/
!jackett/config/cardigann/definitions/
!jackett/config/cardigann/definitions/*.yml

# Ollama Modelfiles
!ollama/
!ollama/modelfiles/
!ollama/modelfiles/Modelfile.*

# GitHub Actions Runner
!github-runner/
!github-runner/Dockerfile
!github-runner/multi-runner-entrypoint.sh
!github-runner/entrypoint-wrapper.sh

# AdGuard Home config
!adguardhome/
!adguardhome/conf/
!adguardhome/conf/AdGuardHome.yaml

# Cloudflare Tunnel (config only — credentials *.json / cert *.pem stay ignored)
!cloudflared/
!cloudflared/config.yml
!cloudflared/README.md

# Docker Agent (LLM Container Monitor)
!docker-agent/
!docker-agent/Dockerfile
!docker-agent/requirements.txt
!docker-agent/app.py
!docker-agent/templates/
!docker-agent/templates/index.html

# ========================================
# Explicitly exclude secrets & heavy data
# ========================================
.env
config.env
*.json
*.log
*.db
*.db-wal
*.db-shm
*.sqlite
*.pem
*.key
*.cert
**/__pycache__/
**/node_modules/
**/cache/
**/data/
**/DataProtection/
